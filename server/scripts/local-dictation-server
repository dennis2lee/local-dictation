#!/usr/bin/env bash
#
# Start, stop and inspect the two language servers as background processes.
# Works the same on Ubuntu and macOS. No init system, no service registration:
# a PID file per language and `nohup` is the whole supervision model.
#
#   local-dictation-server start   all
#   local-dictation-server stop    all
#   local-dictation-server restart ko
#   local-dictation-server status  all
#   local-dictation-server health  all
#   local-dictation-server logs    ko --follow
#   local-dictation-server check   all
#   local-dictation-server version
#   local-dictation-server update  local-dictation-server-0.1.3.tar.gz
#
# Paths come from the environment so the same script serves a system install and
# a checkout:
#
#   LD_HOME        install root                 (default: /opt/local-dictation)
#   LD_APP_DIR     directory containing app/    (default: $LD_HOME/app)
#   LD_CONFIG_DIR  server-{ko,en}.yaml live here (default: $LD_HOME/config)
#   LD_PYTHON      interpreter                  (default: $LD_HOME/venv/bin/python)
#   LD_RUN_DIR     PID files                    (default: $LD_HOME/run)
#   LD_LOG_DIR     log files                    (default: $LD_HOME/log)
#   LD_BACKEND     inference backend            (default: whisper; "fake" loads
#                  no model and emits scripted text — for plumbing checks only)
#   LD_START_TIMEOUT  seconds `start` watches a new process for an early exit
#                  before handing back; 0 to not wait at all (default: 15)

set -euo pipefail

LD_HOME="${LD_HOME:-/opt/local-dictation}"
LD_APP_DIR="${LD_APP_DIR:-$LD_HOME/app}"
LD_CONFIG_DIR="${LD_CONFIG_DIR:-$LD_HOME/config}"
LD_RUN_DIR="${LD_RUN_DIR:-$LD_HOME/run}"
LD_LOG_DIR="${LD_LOG_DIR:-$LD_HOME/log}"
LD_PYTHON="${LD_PYTHON:-$LD_HOME/venv/bin/python}"
LD_BACKEND="${LD_BACKEND:-whisper}"
LD_START_TIMEOUT="${LD_START_TIMEOUT:-15}"

LANGUAGES=(ko en)

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
# One language failing must not take the other down with it: `start all`
# should still try English when Korean cannot start. for_each counts these.
fail() { printf 'error: %s\n' "$*" >&2; return 1; }
info() { printf '%s\n' "$*"; }

usage() {
  # The header ends where the script begins; deriving the range means a comment
  # added above cannot silently truncate the help.
  local last
  last=$(( $(grep -n '^set -euo pipefail' "$0" | head -1 | cut -d: -f1) - 2 ))
  sed -n "3,${last}p" "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

config_for() { printf '%s/server-%s.yaml' "$LD_CONFIG_DIR" "$1"; }
pid_for()    { printf '%s/local-dictation-%s.pid' "$LD_RUN_DIR" "$1"; }
log_for()    { printf '%s/local-dictation-%s.log' "$LD_LOG_DIR" "$1"; }

require_python() {
  [[ -x "$LD_PYTHON" ]] || die "python not found at $LD_PYTHON (set LD_PYTHON)"
}

# An interpreter that cannot import fastapi produces a traceback from inside
# app/main.py, which tells an operator nothing about what to do. Ask first, so a
# half-finished install — one interrupted between pip and the wrapper, or an
# LD_PYTHON pointing at the wrong interpreter — says which it is.
require_dependencies() {
  local missing
  missing="$(LD_NEED_BACKEND="$LD_BACKEND" "$LD_PYTHON" - <<'DEPS' 2>/dev/null || true
import importlib.util, os

needed = ["fastapi", "uvicorn", "yaml", "numpy"]
if os.environ.get("LD_NEED_BACKEND") != "fake":
    needed.append("faster_whisper")
print(" ".join(m for m in needed if importlib.util.find_spec(m) is None))
DEPS
)"
  [[ -z "$missing" ]] && return 0
  die "$LD_PYTHON cannot import: ${missing// /, }
The server's dependencies are not installed in that interpreter. Re-run the
installer over this prefix to put them there:
    <unpacked tarball>/install.sh --prefix $LD_HOME
or point LD_PYTHON at the interpreter that has them."
}

# Ports and scheme live in the YAML. Ask Python rather than keeping a second
# copy here that can drift out of step with the config.
read_config_field() {
  local lang="$1" field="$2" config
  config="$(config_for "$lang")"
  [[ -f "$config" ]] || die "config not found: $config"
  require_python
  LD_FIELD="$field" "$LD_PYTHON" - "$config" <<'PY'
import os, sys, yaml
with open(sys.argv[1], encoding="utf-8") as handle:
    data = yaml.safe_load(handle) or {}
field = os.environ["LD_FIELD"]
if field == "port":
    print((data.get("server") or {}).get("port", ""))
elif field == "scheme":
    print("https" if (data.get("security") or {}).get("tls_certificate") else "http")
PY
}

port_for()   { read_config_field "$1" port; }
scheme_for() { read_config_field "$1" scheme; }

resolve_targets() {
  case "${1:-all}" in
    all)   printf '%s\n' "${LANGUAGES[@]}" ;;
    ko|en) printf '%s\n' "$1" ;;
    *)     die "unknown target '$1' (expected: ko, en or all)" ;;
  esac
}

running() {
  local pid_file pid
  pid_file="$(pid_for "$1")"
  [[ -f "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

do_start() {
  local lang="$1" pid dir
  if running "$lang"; then
    info "$lang: already running (pid $(cat "$(pid_for "$lang")"))"
    return 0
  fi
  require_python
  require_dependencies
  [[ -d "$LD_APP_DIR/app" ]] || die "app package not found under $LD_APP_DIR (set LD_APP_DIR)"

  mkdir -p "$LD_RUN_DIR" "$LD_LOG_DIR" 2>/dev/null || true
  # A `sudo ./install.sh` leaves these owned by root, and the failure that
  # produces is a redirection error inside a background job — which `set -e`
  # never sees, so the start used to be reported as a success with an empty pid.
  # Check up front, so the reason is the message.
  for dir in "$LD_RUN_DIR" "$LD_LOG_DIR"; do
    [[ -d "$dir" ]] || { fail "$lang: $dir does not exist and could not be created"; return 1; }
    [[ -w "$dir" ]] || { fail "$lang: $dir is not writable by $(id -un). Give it to yourself with 'sudo chown -R $(id -un) $dir', or start with sudo."; return 1; }
  done

  rm -f "$(pid_for "$lang")"
  # `cd` into the app dir so `python -m app.main` resolves, and detach fully so
  # closing the terminal does not take the server with it.
  (
    cd "$LD_APP_DIR"
    nohup "$LD_PYTHON" -m app.main --config "$(config_for "$lang")" --backend "$LD_BACKEND" \
      >>"$(log_for "$lang")" 2>&1 &
    echo $! > "$(pid_for "$lang")"
  )
  pid="$(cat "$(pid_for "$lang")" 2>/dev/null || true)"
  [[ -n "$pid" ]] || { fail "$lang: no pid was recorded in $(pid_for "$lang"); the server did not start"; return 1; }

  # A config the server refuses — a model directory that is not there, a
  # certificate it cannot read, a port already taken — kills the process a few
  # seconds in, most of that spent importing ctranslate2. Watch for that rather
  # than reporting a pid that is about to stop existing.
  #
  # "Uvicorn running on" is the marker because it is logged after the socket is
  # bound, which is the last thing that can fail. A model load happens before
  # it and takes minutes, so a real start usually reaches the timeout below —
  # which is not a failure, and says so.
  local waited=0 ticks=$((LD_START_TIMEOUT * 10))
  while (( waited < ticks )); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$(pid_for "$lang")"
      fail "$lang: exited during startup. The last lines of $(log_for "$lang"):"
      tail -n 8 "$(log_for "$lang")" >&2 || true
      return 1
    fi
    if grep -q "Uvicorn running on" "$(log_for "$lang")" 2>/dev/null; then
      info "$lang: started (pid $pid, log $(log_for "$lang"))"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  info "$lang: started (pid $pid), still loading — 'health $lang' says when it can transcribe"
}

do_stop() {
  local lang="$1" pid_file pid
  pid_file="$(pid_for "$lang")"
  if ! running "$lang"; then
    rm -f "$pid_file"
    info "$lang: not running"
    return 0
  fi
  pid="$(cat "$pid_file")"
  kill -TERM "$pid" 2>/dev/null || true
  # uvicorn is configured for a 10 s graceful shutdown; wait 15 before forcing,
  # so an in-flight final transcript still reaches the user.
  for _ in $(seq 1 150); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    info "$lang: did not stop gracefully, sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
  info "$lang: stopped"
}

do_status() {
  local lang="$1"
  if running "$lang"; then
    printf '%-3s running  pid=%-8s port=%s\n' "$lang" "$(cat "$(pid_for "$lang")")" "$(port_for "$lang")"
  else
    printf '%-3s stopped\n' "$lang"
  fi
}

# `health` asks the server itself. A process can be alive while the model is
# still loading, and that difference is exactly what an operator is checking.
do_health() {
  local lang="$1" url body
  url="$(scheme_for "$lang")://127.0.0.1:$(port_for "$lang")/health/ready"
  if body="$(curl --silent --show-error --max-time 5 --insecure "$url" 2>&1)"; then
    printf '%-3s %s\n' "$lang" "$body"
    return 0
  fi
  printf '%-3s UNREACHABLE %s\n' "$lang" "$body"
  return 1
}

do_logs() {
  local lang="$1" follow="$2" file
  file="$(log_for "$lang")"
  [[ -f "$file" ]] || die "no log file at $file"
  if [[ "$follow" == "1" ]]; then tail -f "$file"; else tail -n 200 "$file"; fi
}

do_check() {
  local lang="$1"
  require_python
  require_dependencies
  ( cd "$LD_APP_DIR" && "$LD_PYTHON" -m app.main --config "$(config_for "$lang")" \
      --backend "$LD_BACKEND" --check )
}

# `version` is what you run after an update: the installed tree and the running
# processes can disagree, and that gap is the whole question.
do_version() {
  local file="$LD_HOME/VERSION" installed="unknown"
  [[ -f "$file" ]] && installed="$(tr -d '[:space:]' < "$file")"
  printf 'installed  %s  (%s)\n' "$installed" "$LD_HOME"

  local lang body reported
  for lang in "${LANGUAGES[@]}"; do
    if ! running "$lang"; then
      printf '%-3s        stopped\n' "$lang"
      continue
    fi
    # Retry briefly: `update` asks this the instant after starting a server, and
    # a version reported as unreachable because the question came a few
    # milliseconds early is worse than one that took a second to answer.
    local url attempt
    url="$(scheme_for "$lang")://127.0.0.1:$(port_for "$lang")/health"
    reported=""
    for attempt in 1 2 3 4 5; do
      body="$(curl --silent --max-time 5 --insecure "$url" 2>/dev/null || true)"
      reported="$(printf '%s' "$body" | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"
      [[ -n "$reported" ]] && break
      sleep 0.3
    done
    [[ -n "$reported" ]] || reported="unreachable"
    if [[ "$reported" == "$installed" ]]; then
      printf '%-3s        %s  running\n' "$lang" "$reported"
    else
      printf '%-3s        %s  running — restart it to pick up %s\n' "$lang" "$reported" "$installed"
    fi
  done
}

# Upgrading in the order that cannot go wrong: stop, install the new tree over
# this same prefix, check it, then start again exactly what was running. A
# language someone deliberately stopped stays stopped.
#
# install.sh keeps the configs and the models, and rewrites the code, the venv
# and this script.
do_update() {
  local source="${1:-}"
  [[ -n "$source" ]] || die "update needs the new local-dictation-server-<version>.tar.gz, or a directory it was unpacked into"
  shift

  # install.sh overwrites this very file. Bash has read to EOF by the time main
  # runs, but re-executing from a copy removes the question entirely.
  if [[ "${LD_UPDATING:-0}" != "1" ]]; then
    local copy status
    copy="$(mktemp)"
    cat "$0" > "$copy"
    chmod +x "$copy"
    LD_UPDATING=1 "$copy" update "$source" "$@"
    status=$?
    rm -f "$copy"
    return "$status"
  fi

  local installer="" unpacked=""
  if [[ -d "$source" ]]; then
    installer="$source/install.sh"
  elif [[ -f "$source" ]]; then
    unpacked="$(mktemp -d)"
    tar xzf "$source" -C "$unpacked" || die "could not unpack $source"
    installer="$(find "$unpacked" -maxdepth 2 -name install.sh -type f | head -1)"
  else
    die "not a file or a directory: $source"
  fi
  [[ -n "$installer" && -x "$installer" ]] || die "no runnable install.sh in $source"

  local lang restart=()
  for lang in "${LANGUAGES[@]}"; do
    running "$lang" && restart+=("$lang")
  done
  if [[ ${#restart[@]} -gt 0 ]]; then
    info "stopping ${restart[*]} for the update"
    for lang in "${restart[@]}"; do do_stop "$lang"; done
  else
    info "nothing is running"
  fi

  if ! "$installer" --prefix "$LD_HOME" "$@"; then
    [[ -n "$unpacked" ]] && rm -rf "$unpacked"
    die "the install failed — nothing was started. The previous configs and models are untouched."
  fi
  [[ -n "$unpacked" ]] && rm -rf "$unpacked"

  if ! for_each do_check all; then
    die "the updated install does not check out — nothing was started. Fix the reported problems, then 'start all'."
  fi

  if [[ ${#restart[@]} -gt 0 ]]; then
    for lang in "${restart[@]}"; do do_start "$lang"; done
  fi
  do_version
}

for_each() {
  local action="$1" target="$2" failures=0
  local lang
  for lang in $(resolve_targets "$target"); do
    "$action" "$lang" || failures=$((failures + 1))
  done
  return $((failures > 0))
}

main() {
  [[ $# -ge 1 ]] || usage 1
  local command="$1"; shift

  # These two take their own arguments — a tarball path, nothing at all — so
  # they are dispatched before the ko|en|all parser below.
  case "$command" in
    update)  do_update "$@"; return $? ;;
    version) [[ $# -eq 0 ]] || die "version takes no arguments"; do_version; return 0 ;;
  esac

  local target="all" follow=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      -h|--help)   usage 0 ;;
      ko|en|all)   target="$1" ;;
      *)           die "unexpected argument: $1" ;;
    esac
    shift
  done

  case "$command" in
    start)   for_each do_start   "$target" ;;
    stop)    for_each do_stop    "$target" ;;
    restart) for_each do_stop "$target"; for_each do_start "$target" ;;
    status)  for_each do_status  "$target" ;;
    health)  for_each do_health  "$target" ;;
    check)   for_each do_check   "$target" ;;
    logs)
      local targets; targets="$(resolve_targets "$target")"
      [[ "$(printf '%s' "$targets" | wc -w)" -eq 1 ]] || die "logs needs a single language (ko or en)"
      do_logs "$targets" "$follow"
      ;;
    -h|--help|help) usage 0 ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
