<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4/v5 source for the Local Dictation installer.

  Built by build-msi.ps1, which stages the payload first. Two things are
  deliberately absent from the package:

    * a speech model — several gigabytes, its own licence, and every site
      mirrors it differently. docs/model-setup.md has the one command.
    * a Python runtime — the client finds an interpreter and builds its own
      virtual environment on first use. Bundling one would triple the download
      and pin a version the site may not want.

  Bind paths are supplied on the command line:
    -bindpath stage=<staged tree>
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Local Dictation"
           Manufacturer="Local Dictation"
           Version="$(var.Version)"
           UpgradeCode="8f3b1e2a-7c94-4d61-9a35-6e0b2f4c81d7"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Offline Korean and English dictation" />

    <!-- Downgrades are blocked with a clear message; same-version reinstalls
         are allowed so a repair does not need an uninstall first. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Local Dictation is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="Installed OR (VersionNT &gt;= 603)"
            Message="Local Dictation requires Windows 8.1 or later." />

    <Icon Id="AppIcon" SourceFile="!(bindpath.stage)\local-dictation.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/dennis2lee/local-dictation" />
    <Property Id="ARPNOREPAIR" Value="0" />

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.stage)\License.rtf" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Local Dictation" />
    </StandardDirectory>

    <!-- Harvests the staged tree: the executable, server\ and docs\. Using
         Files rather than a hand-written component list means adding a Python
         module cannot silently fall out of the installer. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="2c7d5a11-9f43-4b8e-8a26-3d5f7b1c9e04">
        <Shortcut Id="StartMenuEntry"
                  Name="Local Dictation"
                  Description="Offline dictation at your cursor"
                  Target="[INSTALLFOLDER]local-dictation.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <!-- A per-user registry value gives the component something to key on,
             which is what lets the shortcut be removed on uninstall. -->
        <RegistryValue Root="HKCU"
                       Key="Software\Local Dictation"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="6b1f0d38-52a7-4c19-b0f4-8e93a2d6157b">
        <Shortcut Id="DesktopEntry"
                  Name="Local Dictation"
                  Target="[INSTALLFOLDER]local-dictation.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Local Dictation"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Local Dictation" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- The last screen tells the user the one thing the installer could not
         do for them. A model is a multi-gigabyte download with its own licence,
         so it stays a deliberate step rather than a silent one. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Before dictating, install a speech model: open PowerShell and run
                     &quot;[INSTALLFOLDER]server\scripts\fetch-model.ps1&quot; -Model large-v3-turbo
                     Then run &quot;[INSTALLFOLDER]local-dictation.exe&quot; --check to confirm everything is ready.
                     See docs\client-install.md in the install folder." />
  </Package>
</Wix>
